#!/usr/bin/env python3
"""Helpers for preparing AKS Flex Node configuration."""

from __future__ import annotations

import argparse
import base64
import hashlib
import ipaddress
import json
import os
import re
import secrets
import shutil
import subprocess
import sys
from datetime import datetime, timedelta, timezone
from pathlib import Path
from urllib.parse import urlsplit

RESOURCE_MANAGER_ENDPOINT = "https://management.azure.com"
DEFAULT_AGENT_POOL_NAME = "aksflexnodes"
DEFAULT_CONTAINERD_VERSION = "2.0.4"
DEFAULT_RUNC_VERSION = "1.1.12"
DEFAULT_CNI_VERSION = "1.5.1"
DEFAULT_NPD_VERSION = "v1.35.1"
DEFAULT_OCI_IMAGE = "ghcr.io/azure/agent-ubuntu2404:v20260619"
DEFAULT_RELEASE_REPOSITORY = os.environ.get("AKS_FLEX_NODE_REPOSITORY", "Azure/AKSFlexNode")
DEFAULT_CONTROLLER_IMAGE = os.environ.get(
    "AKS_FLEX_CONTROLLER_IMAGE",
    f"ghcr.io/{DEFAULT_RELEASE_REPOSITORY.split('/', 1)[0].lower()}/aks-flex-controller",
)
CONTROLLER_SERVICE_PROXY_PATH = "/api/v1/namespaces/kube-system/services/http:aks-flex-controller:80/proxy"
NODE_NAME_PATTERN = re.compile(r"^[a-z0-9](?:[-a-z0-9.]*[a-z0-9])?$")
NODE_NAME_LABEL_PATTERN = re.compile(r"^[a-z0-9](?:[-a-z0-9]*[a-z0-9])?$")
GITHUB_REPOSITORY_PATTERN = re.compile(r"^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$")


def log_info(message: str) -> None:
    print(f"INFO: {message}", file=sys.stderr)


def log_error(message: str) -> None:
    print(f"ERROR: {message}", file=sys.stderr)


def require_command(name: str) -> None:
    if shutil.which(name) is None:
        raise SystemExit(f"ERROR: missing required command: {name}")


def run(args: list[str], *, input_text: str | None = None, capture: bool = False) -> str:
    result = subprocess.run(
        args,
        input=input_text,
        text=True,
        stdout=subprocess.PIPE if capture else None,
        check=True,
    )
    return result.stdout.strip() if capture and result.stdout is not None else ""


def aks_args(args: argparse.Namespace) -> list[str]:
    values = ["--resource-group", args.resource_group, "--name", args.cluster_name]
    if args.subscription:
        values.extend(["--subscription", args.subscription])
    return values


def account_args(args: argparse.Namespace) -> list[str]:
    if args.subscription:
        return ["--subscription", args.subscription]
    return []


def load_admin_kubeconfig(args: argparse.Namespace) -> None:
    log_info("loading AKS admin kubeconfig")
    run(["az", "aks", "get-credentials", *aks_args(args), "--admin", "--overwrite-existing"])


def setup_node_rbac(args: argparse.Namespace) -> None:
    require_command("az")
    require_command("kubectl")
    load_admin_kubeconfig(args)

    log_info("applying bootstrap token RBAC bindings")
    run(["kubectl", "apply", "-f", "-"], input_text=RBAC_MANIFEST)


def generate_bootstrap_token(args: argparse.Namespace) -> str:
    require_command("kubectl")

    token_id = secrets.token_hex(3)
    token_secret = secrets.token_hex(8)
    token = f"{token_id}.{token_secret}"
    expiration = (datetime.now(timezone.utc) + timedelta(hours=24)).strftime("%Y-%m-%dT%H:%M:%SZ")
    manifest = f"""
apiVersion: v1
kind: Secret
metadata:
  name: bootstrap-token-{token_id}
  namespace: kube-system
type: bootstrap.kubernetes.io/token
stringData:
  description: "AKS Flex Node bootstrap token"
  token-id: "{token_id}"
  token-secret: "{token_secret}"
  expiration: "{expiration}"
  usage-bootstrap-authentication: "true"
  usage-bootstrap-signing: "true"
  auth-extra-groups: "system:bootstrappers:aks-flex-node"
""".lstrip()
    run(["kubectl", "apply", "-f", "-"], input_text=manifest)
    return token


def auth_mode(args: argparse.Namespace) -> str:
    modes = [
        ("bootstrap-token", args.bootstrap_token),
        ("identity", args.identity),
        ("service-principal", args.service_principal or bool(args.password)),
        ("arc", args.arc),
    ]
    selected = [name for name, enabled in modes if enabled]
    if len(selected) != 1:
        raise SystemExit(
            "ERROR: choose exactly one auth mode: --bootstrap-token, --identity, "
            "--service-principal, or --arc"
        )
    mode = selected[0]

    if mode == "service-principal" and (not args.username or not args.password):
        raise SystemExit(
            "ERROR: service principal auth requires --username <client-id> and --password <client-secret>"
        )
    if mode == "arc" and (not args.arc_machine_name or not args.arc_resource_group or not args.arc_location):
        raise SystemExit(
            "ERROR: --arc requires --arc-machine-name, --arc-resource-group, and --arc-location"
        )
    return mode


def cluster_metadata(args: argparse.Namespace) -> dict[str, str]:
    log_info("fetching AKS cluster metadata")
    account = account_args(args)
    aks = aks_args(args)
    return {
        "subscription_id": run(["az", "account", "show", *account, "--query", "id", "-o", "tsv"], capture=True),
        "tenant_id": run(
            ["az", "account", "show", *account, "--query", "tenantId", "-o", "tsv"], capture=True
        ),
        "resource_id": run(["az", "aks", "show", *aks, "--query", "id", "-o", "tsv"], capture=True),
        "location": run(["az", "aks", "show", *aks, "--query", "location", "-o", "tsv"], capture=True),
        "kubernetes_version": run(
            ["az", "aks", "show", *aks, "--query", "currentKubernetesVersion || kubernetesVersion", "-o", "tsv"],
            capture=True,
        ),
        "dns_service_ip": run(
            ["az", "aks", "show", *aks, "--query", "networkProfile.dnsServiceIp", "-o", "tsv"], capture=True
        ),
    }


def agent_pool_name(args: argparse.Namespace) -> str:
    return (args.agent_pool_name or "").strip() or DEFAULT_AGENT_POOL_NAME


def cluster_fqdn_from_server_url(server_url: str) -> str:
    server_url = server_url.strip()
    if not server_url:
        return ""
    parsed = urlsplit(server_url)
    if parsed.scheme and parsed.netloc:
        return parsed.netloc
    return server_url


def render_config(args: argparse.Namespace, mode: str, metadata: dict[str, str]) -> dict[str, object]:
    azure: dict[str, object] = {
        "subscriptionId": metadata["subscription_id"],
        "tenantId": metadata["tenant_id"],
        "resourceManagerEndpoint": RESOURCE_MANAGER_ENDPOINT,
        "targetAgentPoolName": metadata["agent_pool_name"],
        "targetCluster": {
            "resourceId": metadata["resource_id"],
            "location": metadata["location"],
        },
    }
    config: dict[str, object] = {
        "azure": azure,
        "agent": {"logLevel": "info", "logDir": "/var/log/aks-flex-node"},
        "components": {"kubernetes": metadata["kubernetes_version"]},
    }

    if mode == "bootstrap-token":
        load_admin_kubeconfig(args)
        log_info("creating bootstrap token")
        token = generate_bootstrap_token(args)
        server_url = run(
            ["kubectl", "config", "view", "--minify", "-o", "jsonpath={.clusters[0].cluster.server}"],
            capture=True,
        )
        ca_cert_data = run(
            [
                "kubectl",
                "config",
                "view",
                "--minify",
                "--raw",
                "-o",
                "jsonpath={.clusters[0].cluster.certificate-authority-data}",
            ],
            capture=True,
        )
        azure["bootstrapToken"] = {"token": token}
        azure["arc"] = {"enabled": False}
        kubelet_config = {
            "clusterFQDN": cluster_fqdn_from_server_url(server_url),
            "caCertData": ca_cert_data,
        }
        if metadata["dns_service_ip"]:
            config["networking"] = {"dnsServiceIP": metadata["dns_service_ip"]}
        config["node"] = {"kubelet": kubelet_config}
    elif mode == "identity":
        managed_identity = {}
        if args.username:
            managed_identity["clientId"] = args.username
        azure["managedIdentity"] = managed_identity
        azure["arc"] = {"enabled": False}
    elif mode == "service-principal":
        azure["servicePrincipal"] = {
            "tenantId": args.tenant or metadata["tenant_id"],
            "clientId": args.username,
            "clientSecret": args.password,
        }
        azure["arc"] = {"enabled": False}
    elif mode == "arc":
        azure["arc"] = {
            "enabled": True,
            "machineName": args.arc_machine_name,
            "resourceGroup": args.arc_resource_group,
            "location": args.arc_location,
            "tags": {"node-type": "flex"},
        }
    else:
        raise SystemExit(f"ERROR: unsupported auth mode: {mode}")

    return config


def write_config(config: dict[str, object], output: str) -> None:
    rendered = json.dumps(config, indent=2) + "\n"
    if output == "-":
        print(rendered, end="")
        return

    path = Path(output)
    path.parent.mkdir(parents=True, exist_ok=True)
    flags = os.O_WRONLY | os.O_CREAT | os.O_TRUNC
    fd = os.open(path, flags, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as handle:
        handle.write(rendered)
    path.chmod(0o600)
    log_info(f"wrote {path}")


def generate_node_config(args: argparse.Namespace) -> None:
    require_command("az")
    require_command("kubectl") if args.bootstrap_token else None
    mode = auth_mode(args)
    metadata = cluster_metadata(args)
    metadata["agent_pool_name"] = agent_pool_name(args)
    config = render_config(args, mode, metadata)
    write_config(config, args.output)


def validate_node_name(value: str) -> str:
    value = value.strip()
    if not value or len(value) > 253 or not NODE_NAME_PATTERN.fullmatch(value):
        raise argparse.ArgumentTypeError("node name must be a lowercase Kubernetes DNS subdomain")
    if any(
        len(label) > 63 or not NODE_NAME_LABEL_PATTERN.fullmatch(label)
        for label in value.split(".")
    ):
        raise argparse.ArgumentTypeError(
            "node name labels must contain 1-63 lowercase alphanumeric or hyphen characters"
        )
    return value


def validate_ip_address(value: str) -> str:
    try:
        return str(ipaddress.ip_address(value.strip()))
    except ValueError as err:
        raise argparse.ArgumentTypeError(f"invalid node IP address: {value}") from err


def validate_release_version(value: str) -> str:
    value = value.strip()
    if not re.fullmatch(r"v[0-9A-Za-z][0-9A-Za-z._-]*", value):
        raise argparse.ArgumentTypeError("release version must start with v and contain only letters, numbers, ., _, or -")
    return value


def validate_github_repository(value: str) -> str:
    value = value.strip()
    if not GITHUB_REPOSITORY_PATTERN.fullmatch(value):
        raise argparse.ArgumentTypeError("GitHub repository must use owner/name form")
    return value


def bootstrap_cluster_data(args: argparse.Namespace) -> dict[str, str]:
    token = generate_bootstrap_token(args)
    server_url = run(
        ["kubectl", "config", "view", "--minify", "-o", "jsonpath={.clusters[0].cluster.server}"],
        capture=True,
    )
    ca_cert_data = run(
        [
            "kubectl",
            "config",
            "view",
            "--minify",
            "--raw",
            "-o",
            "jsonpath={.clusters[0].cluster.certificate-authority-data}",
        ],
        capture=True,
    )
    return {"token": token, "server_url": server_url, "ca_cert_data": ca_cert_data}


def render_bootstrap_config(
    args: argparse.Namespace,
    metadata: dict[str, str],
    cluster_data: dict[str, str],
) -> dict[str, object]:
    config: dict[str, object] = {
        "azure": {
            "subscriptionId": metadata["subscription_id"],
            "tenantId": metadata["tenant_id"],
            "resourceManagerEndpoint": RESOURCE_MANAGER_ENDPOINT,
            "targetAgentPoolName": metadata["agent_pool_name"],
            "bootstrapToken": {"token": cluster_data["token"]},
            "arc": {"enabled": False},
            "targetCluster": {
                "resourceId": metadata["resource_id"],
                "location": metadata["location"],
            },
        },
        "agent": {
            "logLevel": args.log_level,
            "logDir": "/var/log/aks-flex-node",
            "nodeName": args.node_name,
            "machineClient": {
                "mode": "in-cluster",
                "endpointUrl": CONTROLLER_SERVICE_PROXY_PATH,
            },
            "requireMachineRegistration": True,
        },
        "bootstrap": {"ociImage": args.oci_image},
        "components": {
            "kubernetes": metadata["kubernetes_version"],
            "containerd": args.containerd_version,
            "runc": args.runc_version,
        },
        "networking": {
            "dnsServiceIP": metadata["dns_service_ip"],
            "cniVersion": args.cni_version,
        },
        "node": {
            "labels": {"kubernetes.azure.com/managed": "false"},
            "kubelet": {
                "clusterFQDN": cluster_fqdn_from_server_url(cluster_data["server_url"]),
                "caCertData": cluster_data["ca_cert_data"],
                "nodeIP": args.node_ip,
            },
        },
        "npd": {"version": args.npd_version},
    }
    return config


def render_machine_goal(args: argparse.Namespace, metadata: dict[str, str]) -> dict[str, object]:
    machine_id = (
        f"{metadata['resource_id'].rstrip('/')}/agentPools/{metadata['agent_pool_name']}"
        f"/machines/{args.node_name}"
    )
    return {
        "id": machine_id,
        "name": args.node_name,
        "type": "Microsoft.ContainerService/managedClusters/agentPools/machines",
        "properties": {
            "eTag": f"{args.aks_flex_node_version}-{metadata['kubernetes_version']}",
            "provisioningState": "Succeeded",
            "kubernetes": {
                "orchestratorVersion": metadata["kubernetes_version"],
                "maxPods": 110,
                "nodeLabels": {"kubernetes.azure.com/managed": "false"},
                "nodeTaints": [],
                "kubeletConfig": {
                    "imageGcHighThreshold": 85,
                    "imageGcLowThreshold": 80,
                },
            },
        },
    }


def ensure_machine_goal(args: argparse.Namespace, metadata: dict[str, str]) -> None:
    try:
        run(["kubectl", "-n", "kube-system", "get", "configmap", "aks-flex-machines"], capture=True)
    except subprocess.CalledProcessError:
        run(["kubectl", "-n", "kube-system", "create", "configmap", "aks-flex-machines"])

    machine = json.dumps(render_machine_goal(args, metadata), separators=(",", ":"))
    patch = json.dumps({"data": {f"{args.node_name}.json": machine}})
    run(
        [
            "kubectl",
            "-n",
            "kube-system",
            "patch",
            "configmap",
            "aks-flex-machines",
            "--type=merge",
            "-p",
            patch,
        ]
    )


def controller_manifest_url(version: str, repository: str = DEFAULT_RELEASE_REPOSITORY) -> str:
    return (
        f"https://github.com/{repository}/releases/download/"
        f"{version}/aks-flex-controller-{version}.yaml"
    )


def ensure_flex_controller(
    version: str,
    manifest_url: str | None = None,
    repository: str = DEFAULT_RELEASE_REPOSITORY,
) -> None:
    manifest = manifest_url or controller_manifest_url(version, repository)
    run(["kubectl", "apply", "-f", manifest])
    run(
        [
            "kubectl",
            "-n",
            "kube-system",
            "rollout",
            "status",
            "deployment/aks-flex-controller",
            "--timeout=5m",
        ]
    )
    run(["kubectl", "get", "--raw", f"{CONTROLLER_SERVICE_PROXY_PATH}/healthz"], capture=True)


def render_bootstrap_script(
    config: dict[str, object],
    version: str,
    repository: str = DEFAULT_RELEASE_REPOSITORY,
) -> str:
    rendered_config = (json.dumps(config, indent=2) + "\n").encode()
    config_data = base64.b64encode(rendered_config).decode()
    config_checksum = hashlib.sha256(rendered_config).hexdigest()
    return f"""#!/bin/bash
set -euo pipefail

if [[ $(id -u) -ne 0 ]]; then
  echo "AKS Flex Node bootstrap must run as root" >&2
  exit 1
fi

readonly version={version!r}
readonly release_repository={repository!r}
readonly expected_config_checksum={config_checksum!r}

if systemctl is-active --quiet aks-flex-node-agent.service; then
    installed_version=$(/usr/local/bin/aks-flex-node version 2>/dev/null | awk '$1 == "Version:" {{print $2}}')
    installed_config_checksum=$(sha256sum /etc/aks-flex-node/config.json 2>/dev/null | awk '{{print $1}}')
    if [[ "${{installed_version}}" == "${{version}}" && "${{installed_config_checksum}}" == "${{expected_config_checksum}}" ]]; then
        echo "aks-flex-node-agent.service is already converged"
        exit 0
    fi
    echo "aks-flex-node-agent.service is active with an unexpected binary or config; refusing an in-place overwrite" >&2
    exit 1
fi

case $(uname -m) in
  x86_64) arch=amd64 ;;
  aarch64) arch=arm64 ;;
  *) echo "unsupported architecture: $(uname -m)" >&2; exit 1 ;;
esac

readonly asset="aks-flex-node-linux-${{arch}}.tar.gz"
readonly release_url="https://github.com/${{release_repository}}/releases/download/${{version}}"
work_dir=$(mktemp -d)
trap 'rm -rf "${{work_dir}}"' EXIT

export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y --no-install-recommends ca-certificates curl systemd-container nftables util-linux

curl -fsSLo "${{work_dir}}/checksums.txt" "${{release_url}}/checksums.txt"
curl -fsSLo "${{work_dir}}/${{asset}}" "${{release_url}}/${{asset}}"
expected=$(awk -v name="${{asset}}" '$2 == name {{print $1}}' "${{work_dir}}/checksums.txt")
if [[ -z "${{expected}}" ]]; then
  echo "checksum for ${{asset}} is missing" >&2
  exit 1
fi
printf '%s  %s\n' "${{expected}}" "${{work_dir}}/${{asset}}" | sha256sum --check --strict

tar -xzf "${{work_dir}}/${{asset}}" -C "${{work_dir}}"
install -o root -g root -m 0755 "${{work_dir}}/aks-flex-node-linux-${{arch}}" /usr/local/bin/aks-flex-node
install -d -o root -g root -m 0755 /etc/aks-flex-node /var/lib/aks-flex-node /var/log/aks-flex-node
umask 077
config_tmp=$(mktemp /etc/aks-flex-node/config.json.XXXXXX)
printf '%s' {config_data!r} | base64 --decode > "${{config_tmp}}"
chmod 0600 "${{config_tmp}}"
mv -f "${{config_tmp}}" /etc/aks-flex-node/config.json

/usr/local/bin/aks-flex-node preflight --config /etc/aks-flex-node/config.json
umask 022
/usr/local/bin/aks-flex-node start --config /etc/aks-flex-node/config.json
"""


def render_cloud_init(script: str) -> str:
    encoded = base64.b64encode(script.encode()).decode()
    return f"""#cloud-config
write_files:
  - path: /usr/local/sbin/aks-flex-node-bootstrap
    owner: root:root
    permissions: "0700"
    encoding: b64
    content: {encoded}
runcmd:
  - [bash, /usr/local/sbin/aks-flex-node-bootstrap]
"""


def write_sensitive_text(content: str, output: str) -> None:
    if output == "-":
        print(content, end="")
        return
    path = Path(output)
    path.parent.mkdir(parents=True, exist_ok=True)
    flags = os.O_WRONLY | os.O_CREAT | os.O_TRUNC
    fd = os.open(path, flags, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as handle:
        handle.write(content)
    path.chmod(0o600)
    log_info(f"wrote {path}")


def prepare_node(args: argparse.Namespace) -> None:
    require_command("az")
    require_command("kubectl")
    load_admin_kubeconfig(args)
    run(["kubectl", "apply", "-f", "-"], input_text=RBAC_MANIFEST)

    controller_version = args.controller_version or args.aks_flex_node_version
    if not args.skip_controller_install:
        ensure_flex_controller(
            controller_version,
            args.controller_manifest_url,
            args.release_repository,
        )

    metadata = cluster_metadata(args)
    metadata["agent_pool_name"] = agent_pool_name(args)
    cluster_data = bootstrap_cluster_data(args)
    config = render_bootstrap_config(args, metadata, cluster_data)
    ensure_machine_goal(args, metadata)

    script = render_bootstrap_script(
        config,
        args.aks_flex_node_version,
        args.release_repository,
    )
    output = render_cloud_init(script) if args.variant == "cloud-init" else script
    write_sensitive_text(output, args.output)


def render_release_bom(args: argparse.Namespace) -> dict[str, object]:
    version = args.aks_flex_node_version
    artifacts = [
        "aks-flex-config",
        f"aks-flex-controller-{version}.yaml",
        f"aks-flex-controller-{version}.yaml.bundle.json",
        "aks-flex-node-linux-amd64.tar.gz",
        "aks-flex-node-linux-amd64.tar.gz.spdx.json",
        "aks-flex-node-linux-arm64.tar.gz",
        "aks-flex-node-linux-arm64.tar.gz.spdx.json",
        "checksums.txt",
        "checksums.txt.bundle.json",
        f"aks-flex-node-release-bom-{version}.json",
        f"aks-flex-node-release-bom-{version}.json.bundle.json",
    ]
    return {
        "schemaVersion": 1,
        "release": {
            "tag": version,
            "gitCommit": args.git_commit,
            "repository": args.release_repository,
        },
        "artifacts": artifacts,
        "unboundedModuleVersion": args.unbounded_version,
        "controllerImage": {
            "reference": f"{args.controller_image}:{version}",
            "digest": args.controller_digest,
            "platforms": ["linux/amd64", "linux/arm64"],
        },
        "nodeBootstrapDefaults": {
            "kubernetesVersionSource": "AKS control plane version",
            "containerdVersion": DEFAULT_CONTAINERD_VERSION,
            "runcVersion": DEFAULT_RUNC_VERSION,
            "cniPluginVersion": DEFAULT_CNI_VERSION,
            "nodeProblemDetectorVersion": DEFAULT_NPD_VERSION,
            "rootfsImage": DEFAULT_OCI_IMAGE,
        },
    }


def generate_release_bom(args: argparse.Namespace) -> None:
    write_config(render_release_bom(args), args.output)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description="Prepare AKS Flex Node configuration.")
    subparsers = parser.add_subparsers(dest="command", required=True)

    def add_cluster_args(subparser: argparse.ArgumentParser) -> None:
        subparser.add_argument("--resource-group", required=True)
        subparser.add_argument("--cluster-name", required=True)
        subparser.add_argument("--subscription")

    rbac = subparsers.add_parser("setup-node-rbac", help="Apply node bootstrap RBAC bindings.")
    add_cluster_args(rbac)
    rbac.set_defaults(func=setup_node_rbac)

    generate = subparsers.add_parser("generate-node-config", help="Render a Flex Node config.")
    add_cluster_args(generate)
    generate.add_argument(
        "--agent-pool-name",
        default=DEFAULT_AGENT_POOL_NAME,
        help=f"AKS agent pool name written to azure.targetAgentPoolName (default: {DEFAULT_AGENT_POOL_NAME}).",
    )
    generate.add_argument("--bootstrap-token", action="store_true")
    generate.add_argument("--identity", action="store_true")
    generate.add_argument("--service-principal", action="store_true")
    generate.add_argument("--username")
    generate.add_argument("--password")
    generate.add_argument("--tenant")
    generate.add_argument("--arc", action="store_true")
    generate.add_argument("--arc-machine-name")
    generate.add_argument("--arc-resource-group")
    generate.add_argument("--arc-location")
    generate.add_argument("--output", default="-")
    generate.set_defaults(func=generate_node_config)

    prepare = subparsers.add_parser(
        "prepare-node",
        help="Prepare cluster state and render a checksum-verified node bootstrap payload.",
    )
    add_cluster_args(prepare)
    prepare.add_argument("--node-name", required=True, type=validate_node_name)
    prepare.add_argument("--node-ip", required=True, type=validate_ip_address)
    prepare.add_argument("--aks-flex-node-version", required=True, type=validate_release_version)
    prepare.add_argument(
        "--release-repository",
        default=DEFAULT_RELEASE_REPOSITORY,
        type=validate_github_repository,
        help=f"GitHub repository containing release assets (default: {DEFAULT_RELEASE_REPOSITORY}).",
    )
    prepare.add_argument("--controller-version", type=validate_release_version)
    prepare.add_argument("--controller-manifest-url")
    prepare.add_argument("--skip-controller-install", action="store_true")
    prepare.add_argument("--agent-pool-name", default=DEFAULT_AGENT_POOL_NAME)
    prepare.add_argument("--containerd-version", default=DEFAULT_CONTAINERD_VERSION)
    prepare.add_argument("--runc-version", default=DEFAULT_RUNC_VERSION)
    prepare.add_argument("--cni-version", default=DEFAULT_CNI_VERSION)
    prepare.add_argument("--npd-version", default=DEFAULT_NPD_VERSION)
    prepare.add_argument("--oci-image", default=DEFAULT_OCI_IMAGE)
    prepare.add_argument("--log-level", choices=["debug", "info", "warning", "error"], default="info")
    prepare.add_argument("--variant", choices=["script", "cloud-init"], default="cloud-init")
    prepare.add_argument("--output", default="-")
    prepare.set_defaults(func=prepare_node)

    bom = subparsers.add_parser("release-bom", help="Render the AKS Flex Node release bill of materials.")
    bom.add_argument("--aks-flex-node-version", required=True, type=validate_release_version)
    bom.add_argument("--git-commit", required=True)
    bom.add_argument("--controller-digest", required=True)
    bom.add_argument("--controller-image", default=DEFAULT_CONTROLLER_IMAGE)
    bom.add_argument(
        "--release-repository",
        default=DEFAULT_RELEASE_REPOSITORY,
        type=validate_github_repository,
    )
    bom.add_argument("--unbounded-version", required=True)
    bom.add_argument("--output", required=True)
    bom.set_defaults(func=generate_release_bom)

    return parser


